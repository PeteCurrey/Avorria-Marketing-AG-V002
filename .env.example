# Avorria Marketing Site — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://avorria.com

# ─── Form delivery ────────────────────────────────────────────────────────────
# The provider-agnostic delivery layer reads from these vars.
# At minimum, set EMAIL_FROM and EMAIL_TO.
# DELIVERY_PROVIDER options: "resend" | "nodemailer" | "webhook" | "log"
DELIVERY_PROVIDER=log

# Resend (recommended for Vercel)
RESEND_API_KEY=

# Nodemailer SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Webhook fallback
ENQUIRY_WEBHOOK_URL=

# Email addresses
EMAIL_FROM=hello@avorria.com
EMAIL_TO=hello@avorria.com

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Max enquiry submissions per IP per hour (default 3)
RATE_LIMIT_MAX=3

# ─── Analytics ────────────────────────────────────────────────────────────────
# Privacy-conscious analytics (e.g. Plausible, Fathom, PostHog)
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_HOST=
