# Avorria — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it is gitignored.
# For production, set all variables in your hosting provider's env settings.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Site ─────────────────────────────────────────────────────────────────────
# Required. Public canonical URL used for metadata, sitemap, canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment flag: development | staging | production
# Controls X-Robots-Tag noindex on non-production deployments.
NEXT_PUBLIC_ENVIRONMENT=development

# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

# Public — safe to expose in browser bundles
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret — server-only. NEVER expose client-side. NEVER commit.
# Used only in lib/supabase/server-admin.ts (behind 'server-only' import guard)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Email Delivery ───────────────────────────────────────────────────────────
# DELIVERY_PROVIDER: log | resend | nodemailer | webhook
# "log" prints to console — zero external deps, good for dev.
DELIVERY_PROVIDER=log

# Resend — needed when DELIVERY_PROVIDER=resend
# Get key at: https://resend.com/api-keys
RESEND_API_KEY=

# Sender / recipient for all enquiry emails
EMAIL_FROM=hello@avorria.com
EMAIL_TO=hello@avorria.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max enquiry form submissions per IP per hour. Default: 3.
# Raise for local dev/testing: RATE_LIMIT_MAX=100
RATE_LIMIT_MAX=3

# ─── Analytics ────────────────────────────────────────────────────────────────
# Leave blank — analytics no-ops in dev. Provider-agnostic: implement track() dispatch.
# Plausible:  NEXT_PUBLIC_ANALYTICS_ID=avorria.com
# Fathom:     NEXT_PUBLIC_ANALYTICS_ID=XXXXXXXX (8-char site ID)
# PostHog:    NEXT_PUBLIC_ANALYTICS_ID=phc_XXX, NEXT_PUBLIC_ANALYTICS_HOST=https://app.posthog.com
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_HOST=

# ─── Error Monitoring ─────────────────────────────────────────────────────────
# Set to activate Sentry. Requires @sentry/nextjs installed.
# Leave blank in development.
SENTRY_DSN=

# ─── Seed Guard ───────────────────────────────────────────────────────────────
# Set to "true" to allow pnpm run seed to execute.
# NEVER set this in staging or production.
SEED_ENABLED=false
